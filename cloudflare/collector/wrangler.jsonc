{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rntlbt-portfolio-collector",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "triggers": {
    "crons": ["30 16 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://rntlbt.github.io",
    "RETENTION_DAYS": "180"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rntlbt-portfolio-db",
      "database_id": "030b0c55-0129-4c01-9d19-f2a43c549a42",
      "migrations_dir": "../migrations"
    }
  ],
  "env": {
    "development": {
      "vars": {
        "ALLOWED_ORIGINS": "http://localhost:8787,http://127.0.0.1:8787,http://localhost:5500,http://127.0.0.1:5500",
        "RETENTION_DAYS": "180"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "rntlbt-portfolio-db",
          "database_id": "030b0c55-0129-4c01-9d19-f2a43c549a42",
          "migrations_dir": "../migrations"
        }
      ]
    }
  }
}
